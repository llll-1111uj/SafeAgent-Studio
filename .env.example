# Copy to .env and fill in the values. .env is not committed.

# DeepSeek, through the Anthropic-compatible endpoint this process already calls.
# Put the DeepSeek API key in ANTHROPIC_API_KEY. The SDK reads that name itself.
# MODEL_ID is sent to DeepSeek and to Langfuse. deepseek-chat and deepseek-reasoner
# are the ids Langfuse can price.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
MODEL_ID=deepseek-chat

# Leave empty when ANTHROPIC_API_KEY is set. A custom base URL drops this token.
ANTHROPIC_AUTH_TOKEN=

# Langfuse. Leave the keys empty to run with tracing disabled.
# LANGFUSE_HOST is Langfuse Cloud; replace it with a self-hosted URL if you run your own.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Control plane bind address. docker-compose overrides the host to 0.0.0.0.
SAFEAGENT_HOST=127.0.0.1
SAFEAGENT_PORT=8000

# Long-memory cosine distance. Larger is less similar. Hits above this are not injected.
MEMORY_DISTANCE_MAX=0.7

# Frontend, used by Vite. Not read by the Python process.
VITE_API_ORIGIN=http://127.0.0.1:8000
